<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="autonomous_mobile_robot">

    <xacro:include filename="wheel.xacro"/>

    <!-- ROBOT DIMENSIONS-->
    <xacro:property name="base_length" value="0.40" />
    <xacro:property name="base_width" value="0.30" />
    <xacro:property name="base_height" value="0.15" />
    <xacro:property name="wheel_radius" value="0.05" />
    <xacro:property name="wheel_width" value="0.03" />
    <xacro:property name="wheel_center_y" value="${base_width / 2 + wheel_width / 2}" />

    <!--Main
    chassis-->
    <link name="base_footprint"></link>

    <link name="base_link">
        <visual>
            <origin xyz="-0.035 0.0 0.05" rpy="0.0 0.0 0.0" />
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}" />
            </geometry>
            <material name="blue">
                <color rgba="0.1 0.3 0.8 1.0" />
            </material>
        </visual>
    </link>

    <joint name="base_footprint_to_base_link" type="fixed">
        <origin xyz="0.0 0.0 0.05" rpy="0.0 0.0 0.0" />
        <parent link="base_footprint" />
        <child link="base_link" />
    </joint>

    <xacro:drive_wheel side="left" y="${wheel_center_y}"></xacro:drive_wheel>
    <xacro:drive_wheel side="right" y="${-wheel_center_y}"></xacro:drive_wheel>


</robot>